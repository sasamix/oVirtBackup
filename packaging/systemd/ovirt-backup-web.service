[Unit]
Description=oVirt Backup Console
After=network-online.target ovirt-backup-scheduler-control.service
Wants=network-online.target ovirt-backup-scheduler-control.service

[Service]
Type=simple
User=ovirt-backup
Group=ovirt-backup
ExecStart=/usr/bin/python3 /usr/libexec/ovirt-backup/ovirt_backup_web.py --config /etc/ovirt-backup/config/backup.cfg --static-dir /usr/share/ovirt-backup/web --token-file /etc/ovirt-backup/web.token --listen 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
# Manual runner processes are intentionally independent of a console restart.
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/etc/ovirt-backup/web.token /usr/share/ovirt-backup /usr/libexec/ovirt-backup
ReadWritePaths=/etc/ovirt-backup/config /var/lib/ovirt-backup /var/log/ovirt-backup

[Install]
WantedBy=multi-user.target
