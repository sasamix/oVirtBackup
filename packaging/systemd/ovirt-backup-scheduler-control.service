[Unit]
Description=oVirt Backup Scheduler Controller
After=local-fs.target
Before=ovirt-backup-web.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/ovirt-backup/ovirt_backup_scheduler.py serve
Restart=on-failure
RestartSec=2
RuntimeDirectory=ovirt-backup
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/ovirt-backup /etc/systemd/system /run/ovirt-backup

[Install]
WantedBy=multi-user.target
